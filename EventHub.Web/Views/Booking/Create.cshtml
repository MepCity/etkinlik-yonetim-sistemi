@* Bu görünüm, bilet satın alma (rezervasyon oluşturma) ödeme formunu render eder. *@
@model CreateBookingViewModel

@{
    ViewData["Title"] = "Ödeme";
}

<div class="container py-4" style="max-width:560px">
    <h2 class="mb-1">@Model.EventName</h2>
    <p class="text-muted mb-4">Bilet satın almak için ödeme bilgilerinizi girin.</p>

    <form method="post" id="paymentForm">
        @* Gizli alanlar: EventId, EventName ve EventPrice controller'a form verisiyle iletilir. *@
        <input type="hidden" asp-for="EventId" />
        <input type="hidden" asp-for="EventName" />
        <input type="hidden" asp-for="EventPrice" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="validationSummary"></div>

        <div class="card shadow-sm mb-4">
            <div class="card-header fw-semibold">Bilet Bilgisi</div>
            <div class="card-body">
                <div class="mb-3">
                    @* asp-for ile Quantity alanını model özelliğine bağla; doğrulama mesajı span ile gösterilir. *@
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" class="form-control" type="number" min="1" id="quantityInput" />
                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>
                <div class="d-flex justify-content-between fw-semibold border-top pt-2 mt-2">
                    <span>Toplam Tutar</span>
                    @* Başlangıçta birim fiyatı göster; JavaScript ile miktar değiştikçe dinamik güncellenir. *@
                    <span id="totalPrice">@Model.EventPrice.ToString("C2", new System.Globalization.CultureInfo("tr-TR"))</span>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header fw-semibold">Kart Bilgileri</div>
            <div class="card-body">
                <div class="mb-3">
                    @* Kart sahibi adı alanı; autocomplete="cc-name" tarayıcı otomatik doldurmayı destekler. *@
                    <label asp-for="CardHolderName" class="form-label"></label>
                    <input asp-for="CardHolderName" class="form-control" placeholder="AD SOYAD" autocomplete="cc-name" />
                    <span asp-validation-for="CardHolderName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    @* Kart numarası alanı; JavaScript ile 4'lü gruplar halinde biçimlendirilir ve Luhn kontrolü yapılır. *@
                    <label asp-for="CardNumber" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="CardNumber" class="form-control font-monospace"
                               id="cardNumberInput" placeholder="0000 0000 0000 0000"
                               maxlength="19" autocomplete="cc-number" inputmode="numeric" />
                        <span class="input-group-text" id="cardIcon"><i class="fas fa-credit-card"></i></span>
                    </div>
                    @* Luhn doğrulama sonucu (geçerli/geçersiz) JavaScript tarafından bu alana yazılır. *@
                    <div id="luhnFeedback" class="small mt-1"></div>
                    <span asp-validation-for="CardNumber" class="text-danger small"></span>
                </div>

                <div class="row g-3">
                    <div class="col-6">
                        @* Son kullanma tarihi alanı; JavaScript ile AA/YY formatına otomatik dönüştürülür. *@
                        <label asp-for="ExpiryDate" class="form-label"></label>
                        <input asp-for="ExpiryDate" class="form-control font-monospace"
                               id="expiryInput" placeholder="AA/YY" maxlength="5"
                               autocomplete="cc-exp" inputmode="numeric" />
                        <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        @* CVV alanı type="password" ile maskelenir; maksimum 4 hane girilir. *@
                        <label asp-for="Cvv" class="form-label"></label>
                        <input asp-for="Cvv" class="form-control font-monospace"
                               type="password" placeholder="•••" maxlength="4"
                               autocomplete="cc-csc" inputmode="numeric" />
                        <span asp-validation-for="Cvv" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success flex-grow-1" id="submitBtn">
                <i class="fas fa-lock me-1"></i> Ödemeyi Tamamla
            </button>
            <a asp-controller="Event" asp-action="Index" class="btn btn-secondary">Geri Dön</a>
        </div>
    </form>
</div>

@* İstemci tarafı doğrulama betikleri ve ödeme formu etkileşim betikleri burada yüklenir. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const unitPrice = @Model.EventPrice.ToString(System.Globalization.CultureInfo.InvariantCulture);

        // Toplam fiyat hesapla
        document.getElementById('quantityInput').addEventListener('input', function () {
            const qty = Math.max(1, parseInt(this.value) || 1);
            const total = (qty * unitPrice).toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' });
            document.getElementById('totalPrice').textContent = total;
        });

        // Kart numarası formatlama (her 4 rakamda boşluk)
        document.getElementById('cardNumberInput').addEventListener('input', function () {
            let val = this.value.replace(/\D/g, '').substring(0, 16);
            this.value = val.replace(/(.{4})/g, '$1 ').trim();
            checkLuhn(val);
        });

        // Son kullanma tarihi formatlama (AA/YY)
        document.getElementById('expiryInput').addEventListener('input', function () {
            let val = this.value.replace(/\D/g, '').substring(0, 4);
            if (val.length >= 3) val = val.substring(0, 2) + '/' + val.substring(2);
            this.value = val;
        });

        // Luhn algoritması (client-side)
        function checkLuhn(digits) {
            const el = document.getElementById('luhnFeedback');
            if (digits.length < 13) { el.textContent = ''; return; }
            let sum = 0, alt = false;
            for (let i = digits.length - 1; i >= 0; i--) {
                let n = parseInt(digits[i]);
                if (alt) { n *= 2; if (n > 9) n -= 9; }
                sum += n;
                alt = !alt;
            }
            if (sum % 10 === 0) {
                el.innerHTML = '<span class="text-success"><i class="fas fa-check-circle"></i> Geçerli kart numarası</span>';
            } else {
                el.innerHTML = '<span class="text-danger"><i class="fas fa-times-circle"></i> Geçersiz kart numarası</span>';
            }
        }
    </script>
}
