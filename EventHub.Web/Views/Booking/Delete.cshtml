@model Booking
@{
    ViewData["Title"] = "Kaydı İptal Et";
}

<h1>@Model.Event.Name etkinliği için kaydı iptal etmek istediğinize emin misiniz?</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Quantity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Quantity)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.BookingDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.BookingDate)
        </dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Kaydı İptal Et" class="btn btn-danger" /> 
        <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
    </form>
</div>
