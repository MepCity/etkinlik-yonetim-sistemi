@* Bu görünüm, oturum açmış kullanıcının tüm rezervasyonlarını tablo halinde listeler. *@
@model IEnumerable<Booking>

<div class="container mt-4">
    <h2>Katıldığım Etkinlikler</h2>

    @* Kullanıcının en az bir rezervasyonu varsa tablo göster; yoksa bilgi mesajı göster. *@
    @if (Model.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th class="text-start">Etkinlik Adı</th>
                    <th class="text-center">Tarih</th>
                    <th class="text-center">Konum</th>
                    <th class="text-end">Fiyat</th>
                    <th class="text-center">Kayıt Tarihi</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @* Her rezervasyon için ilgili etkinlik bilgileri ve iptal butonu olan bir tablo satırı oluştur. *@
                @foreach (var booking in Model)
                {
                    <tr>
                        <td class="text-start">@booking.Event.Name</td>
                        <td class="text-center">@DateOnly.FromDateTime(booking.Event.StartDate)</td>
                        <td class="text-center">@booking.Event.Location</td>
                        <td class="text-end">@booking.Event.Price.ToString("C")</td>
                        <td class="text-center">@booking.BookingDate.ToShortDateString()</td>
                        <td class="text-center">
                            @* asp-route-id ile rezervasyon kimliğini Delete action'ına ilet. *@
                            <a asp-action="Delete" asp-route-id="@booking.Id" class="btn btn-outline-danger">
                                <i class="fas fa-times"></i> İptal Et
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            Henüz herhangi bir etkinliğe katılmadınız.
        </div>
    }
</div>
