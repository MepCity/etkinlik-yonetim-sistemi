@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container-fluid py-5 bg-light">
    <div class="container">
        <div class="text-center mb-4">
            <h1 class="display-4 fw-bold text-primary mb-3">EventHub ile etkinlik planlayın, yayınlayın ve katılın</h1>
            <p class="lead text-muted mb-4">Organizatörler ve katılımcılar için odaklı bir etkinlik ve workshop yönetim platformu.</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-body p-0">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <div class="feature-card p-5 h-100 bg-primary bg-opacity-10 border-end">
                                    <div class="d-inline-block p-3 bg-primary bg-opacity-10 rounded-circle mb-3">
                                        <i class="fas fa-calendar-check fs-2 text-primary"></i>
                                    </div>
                                    <h3 class="h5 fw-bold mb-2">Kolay Kayıt</h3>
                                    <p class="text-muted mb-0">
                                        İlgi çekici etkinlikleri seçin, kaydınızı oluşturun
                                        ve yerinizi saniyeler içinde ayırtın.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="feature-card p-5 h-100 bg-warning bg-opacity-10 border-end">
                                    <div class="d-inline-block p-3 bg-warning bg-opacity-10 rounded-circle mb-3">
                                        <i class="fas fa-shield-alt fs-2 text-warning"></i>
                                    </div>
                                    <h3 class="h5 fw-bold mb-2">Esnek İptal</h3>
                                    <p class="text-muted mb-0">
                                        Planlarınız değiştiyse sorun değil. Katılım kayıtlarınızı
                                        zahmetsizce iptal edin veya yönetin.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="feature-card p-5 h-100 bg-success bg-opacity-10">
                                    <div class="d-inline-block p-3 bg-success bg-opacity-10 rounded-circle mb-3">
                                        <i class="fas fa-clock fs-2 text-success"></i>
                                    </div>
                                    <h3 class="h5 fw-bold mb-2">Her Zaman Erişilebilir</h3>
                                    <p class="text-muted mb-0">
                                        İstediğiniz yerden, günün her saatinde
                                        etkinliklerinizi ve kayıtlarınızı yönetin.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
