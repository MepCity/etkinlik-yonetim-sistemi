@* Bu görünüm, yeni etkinlik oluşturma formunu render eder; model olarak CreateEventViewModel alır. *@
@model CreateEventViewModel
@{
    ViewData["Title"] = "Etkinlik Oluştur";
}

<h2>Etkinlik Oluştur</h2>
@* enctype="multipart/form-data" görsel dosyası yüklemeye izin vermek için gereklidir. *@
<form asp-action="Create" method="post" enctype="multipart/form-data">
    @* Form alanlarını içeren ortak kısmi görünümü yükle; hem Create hem Edit sayfasında kullanılır. *@
    <partial name="_CreateUpdatePartialView" model="Model" />

    <div class="row mt-3">
        <div class="col-12">
            <button type="submit" class="btn btn-primary">Oluştur</button>
            <a class="btn btn-dark" asp-action="Index">Listeye Dön</a>
        </div>
    </div>
</form>

@* İstemci tarafı doğrulama betiklerini Scripts bölümüne ekle. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
