@* Bu görünüm, mevcut bir etkinliği düzenleme formunu render eder; model olarak CreateEventViewModel alır. *@
@model CreateEventViewModel
@{
    ViewData["Title"] = "Etkinliği Düzenle";
}

<h2>@Model.Name Etkinliğini Düzenle</h2>
@* enctype="multipart/form-data" yeni görsel yüklemeye izin vermek için gereklidir. *@
<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @* Form alanlarını içeren ortak kısmi görünümü yükle; Create ile aynı partial kullanılır. *@
    <partial name="_CreateUpdatePartialView" model="Model" />

    <div class="container py-2 m-auto">
        <button type="submit" class="btn btn-warning">Değişiklikleri Kaydet</button>
        <a class="btn btn-dark px-3 py-2" asp-action="Index">Listeye Dön</a>
    </div>
</form>

@* İstemci tarafı doğrulama betiklerini Scripts bölümüne ekle. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
