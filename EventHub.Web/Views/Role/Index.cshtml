
@model IEnumerable<IdentityRole>

@{
    ViewData["Title"] = "Roller";
    Layout = "~/Views/Shared/_IdentityLayout.cshtml";

}


<h1 class="mt-2 text-center">Tüm Roller</h1>

<partial name="Partials/CreateRolePartialView" model="new RoleViewModel()"/>

@if(Model.Count() > 0){
    <table class="table table-striped table-hover">

        <thead>
            <tr>
                <th>@Html.DisplayNameFor(r => r.Id)</th>
                <th>@Html.DisplayNameFor(r => r.Name)</th>
                <th>İşlemler</th>
            </tr>
        </thead>


        <tbody>
            @foreach(var role in Model){
                <tr>
                    <td>@role.Id</td>
                    <td>@role.Name</td>
                    <td>
                        <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@role.Id">Düzenle</a>
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@role.Id" />
                            <button type="submit" class="btn btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }

        </tbody>

    </table>
}

else {
    <div class="mt-3 p-3 alert-warning">
        <h2>Henüz rol bulunmuyor.</h2>    
</div>
}


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
