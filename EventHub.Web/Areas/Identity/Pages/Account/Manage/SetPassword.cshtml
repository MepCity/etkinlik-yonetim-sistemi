@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Şifre Belirle";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3>Şifrenizi Belirleyin</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<p class="text-info">
    Bu site için yerel bir kullanıcı adı/şifre tanımınız yok. Harici giriş kullanmadan oturum açabilmek için bir şifre belirleyin.
</p>
<div class="row">
    <div class="col-md-6">
        <form id="set-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="Yeni şifrenizi girin."/>
                <label asp-for="Input.NewPassword" class="form-label"></label>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Yeni şifrenizi tekrar girin."/>
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Şifreyi Kaydet</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
